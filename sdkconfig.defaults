# Default sdkconfig parameters to use the OTA.
# The project targets a 16 MiB SPI flash and uses a custom table based on the
# official ESP-IDF two-OTA layout, expanded to fill the available capacity.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# PSRAM与CPU：该板使用8 MiB Octal/OPI、80 MHz，CLK=IO30 / CS=IO26。
# 240 MHz同时为UI、TLS流式音频及可选本地WakeNet回退留出余量。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_PM_ENABLE=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_JULIA_BAT_CONTROL_GPIO=7
CONFIG_JULIA_BOOT_CPU_MAX_FREQ_80=y
CONFIG_JULIA_RUNTIME_CPU_MAX_FREQ_160=y
CONFIG_JULIA_BOOT_STAGE_DELAY_MS=250
CONFIG_JULIA_BOOT_SETTLE_DELAY_MS=1500
CONFIG_JULIA_BOOT_BRIGHTNESS_PERCENT=25
CONFIG_JULIA_BATTERY_DIAGNOSTICS=y
CONFIG_JULIA_BATTERY_SAMPLE_COUNT=32
CONFIG_JULIA_BATTERY_MONITOR_INTERVAL_SECONDS=10
CONFIG_JULIA_BATTERY_PRESENT_MIN_MV=2500
CONFIG_JULIA_BATTERY_PRESENT_MAX_MV=4350
CONFIG_JULIA_BATTERY_LOW_ENTER_PERCENT=15
CONFIG_JULIA_BATTERY_LOW_EXIT_PERCENT=25
CONFIG_JULIA_BATTERY_CHARGE_RISE_MV=20
CONFIG_JULIA_BATTERY_CHARGE_EXIT_DROP_MV=20
CONFIG_JULIA_BATTERY_CHARGE_CONFIRM_SAMPLES=2
CONFIG_JULIA_BATTERY_CHARGE_EVIDENCE_TIMEOUT_SECONDS=60

# LVGL 8.3 display format.  Generated avatar RGB565 assets are byte-swapped
# for the ST77916 SPI wire order and enforce this setting at compile time.
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_DEPTH=16
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_CUSTOM_INCLUDE="stdlib.h"

# 本地WakeNet回退配置。CONFIG_JULIA_SERVER_WAKE_ENABLE=y时组件注册为空，
# 这些选项不参与当前固件；关闭服务器唤醒开关即可恢复并打包该模型。
CONFIG_USE_AFE=y
CONFIG_AFE_INTERFACE_V1=y
CONFIG_USE_WAKENET=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

# The table keeps a 512 KiB model slot for a future custom wake model and a
# 1 MiB FAT audio-data partition. Never accept an artifact larger than FAT.
CONFIG_AUDIO_MAX_FILE_SIZE=1048576

# Enable bootloader-managed first-boot validation and rollback.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# OTA image identity must match project(julia_fused_base) in CMakeLists.txt.
CONFIG_OTA_IMAGE_PROJECT_NAME="julia_fused_base"

# Communication reliability defaults. The local WSS integration token is configured
# below; production credentials must be injected through a protected provisioning flow.
CONFIG_OTA_PRODUCT_ID="julia-ai-device"
CONFIG_COMM_HEARTBEAT_INTERVAL_SECONDS=60
CONFIG_COMM_RECONNECT_INTERVAL_SECONDS=10
CONFIG_COMM_DEVICE_AUTH_NONE=y
CONFIG_COMM_DEVICE_AUTH_TOKEN_VALUE="julia-test-token-2026"
CONFIG_COMM_MQTT_BROKER_URI="mqtt://192.168.137.1:1883"
CONFIG_OTA_CHECK_RESPONSE_TIMEOUT_SECONDS=15
CONFIG_OTA_CHECK_RESPONSE_RETRY_COUNT=2
CONFIG_OTA_CHECK_RESPONSE_RETRY_BASE_SECONDS=2
CONFIG_OTA_CHECK_RESPONSE_RETRY_MAX_SECONDS=10
CONFIG_OTA_CHECK_RECOVERY_INITIAL_SECONDS=30
CONFIG_OTA_CHECK_RECOVERY_MAX_SECONDS=300
CONFIG_COMM_MQTT_SUBACK_TIMEOUT_SECONDS=15

# WSS voice stream keepalive: idle links are healthy; liveness is probed with
# client PINGs and only a missing PONG tears the link down.
CONFIG_WSS_KEEPALIVE_INTERVAL_SECONDS=15
CONFIG_WSS_PONG_TIMEOUT_SECONDS=10
CONFIG_WSS_CLOSE_WAIT_MS=500
CONFIG_WSS_TOKEN="julia-test-token-2026"
CONFIG_WSS_SERVER_HOST="192.168.137.1"
CONFIG_JULIA_SERVER_WAKE_ENABLE=y
CONFIG_WSS_FRAME_WRITE_BUDGET_MS=3500
CONFIG_JULIA_MIC_GAIN_PERCENT=70
CONFIG_JULIA_SPEAKER_VOLUME_PERCENT=50

# The configured local hotspot is WPA2-PSK, not open authentication.
CONFIG_EXAMPLE_WIFI_AUTH_WPA2_PSK=y
# Windows Mobile Hotspot advertises WPA2/WPA3 transition mode. Force the
# station onto its WPA2 path because SAE authentication repeatedly expires.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n

# Voice push demo (device-initiated) is DISABLED by default: the WSS session is
# driven by the cloud server (server sends FILE_SEND, device pushes the file).
# Set CONFIG_VOICE_PUSH_DEMO_ENABLE=y to also test unsolicited device-initiated
# pushes (see voice_push_demo.c).

# SD card (SDMMC 1-bit, Waveshare ESP32-S3-LCD-1.85): CLK=IO14, CMD=IO17,
# D0=IO16; D3/CS via the on-board TCA9554 P2 (Extend_IO3, I2C SCL=IO10/SDA=IO11,
# addr 0x20). Mounted at /sdcard for SD:/ URIs. Proven by the VOICE DATA
# BENCHMARK 08_sd_tool project on the same board.
CONFIG_SD_CARD_ENABLE=y
CONFIG_SD_CARD_PIN_CLK=14
CONFIG_SD_CARD_PIN_CMD=17
CONFIG_SD_CARD_PIN_D0=16
CONFIG_SD_CARD_I2C_SCL=10
CONFIG_SD_CARD_I2C_SDA=11
CONFIG_SD_CARD_FREQ_KHZ=20000

# OTA transport failures remain retryable. After the threshold, use a bounded,
# persistent cooldown instead of permanently quarantining the artifact.
CONFIG_OTA_DOWNLOAD_RETRY_THRESHOLD=3
CONFIG_OTA_DOWNLOAD_COOLDOWN_BASE_SECONDS=60
CONFIG_OTA_DOWNLOAD_COOLDOWN_MAX_SECONDS=3600

# TCP WebSocket transport is not part of this application.
# CONFIG_WS_TRANSPORT is not set
# Wi-Fi remains a background service.  Retry timing is configured by the
# application lifecycle manager rather than the example component's finite
# synchronous retry loop.
CONFIG_NETWORK_WIFI_RETRY_BASE_MS=1000
CONFIG_NETWORK_WIFI_RETRY_MAX_MS=60000
CONFIG_NETWORK_WIFI_RETRY_JITTER_PERCENT=20
CONFIG_NETWORK_WIFI_CONNECT_TIMEOUT_MS=20000
CONFIG_NETWORK_WIFI_MAX_TX_POWER_DBM=14
CONFIG_NETWORK_WIFI_INITIAL_DIAGNOSTIC_SCAN=n
CONFIG_EXAMPLE_WIFI_CONN_MAX_RETRY=-1
CONFIG_USE_MULTINET=n
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# Julia display idle policy and RTC/SNTP wall clock.
CONFIG_JULIA_DISPLAY_SLEEP_TIMEOUT_SECONDS=600
CONFIG_JULIA_STANDBY_SLEEP_TIMEOUT_SECONDS=300
CONFIG_JULIA_SILENT_STANDBY_TIMEOUT_SECONDS=1800
CONFIG_JULIA_SERVICE_INIT_TIMEOUT_SECONDS=30
CONFIG_JULIA_COMPANION_BRIGHTNESS_PERCENT=50
CONFIG_JULIA_SILENT_BRIGHTNESS_PERCENT=50
CONFIG_JULIA_FAULT_RESET_DELAY_MS=3000
CONFIG_JULIA_FAULT_QUICK_UPTIME_SECONDS=60
CONFIG_JULIA_FAULT_AUTO_RESET_LIMIT=3
CONFIG_JULIA_DISPLAY_ACTIVITY_POLL_MS=500
CONFIG_JULIA_DISPLAY_BREATHE_MIN_PERCENT=5
CONFIG_JULIA_DISPLAY_BREATHE_MAX_PERCENT=30
CONFIG_JULIA_DISPLAY_BREATHE_PERIOD_MS=4000
CONFIG_JULIA_RTC_ENABLE=y
CONFIG_JULIA_NIGHT_SLEEP_ENABLE=y
CONFIG_JULIA_NIGHT_SLEEP_START_HOUR=23
CONFIG_JULIA_NIGHT_SLEEP_END_HOUR=7
CONFIG_JULIA_NIGHT_SLEEP_GRACE_SECONDS=300
CONFIG_JULIA_NIGHT_SCHEDULE_POLL_MS=5000
CONFIG_JULIA_IMU_MOTION_ENABLE=y
CONFIG_JULIA_IMU_MOTION_SAMPLE_MS=200
CONFIG_JULIA_IMU_MOTION_CONFIRM_FRAMES=4
CONFIG_JULIA_IMU_MOTION_COOLDOWN_MS=10000
CONFIG_JULIA_IMU_ACCEL_DELTA_MG=200
CONFIG_JULIA_IMU_GYRO_THRESHOLD_DPS=25
CONFIG_JULIA_TIMEZONE="CST-8"
CONFIG_JULIA_SNTP_SERVER="pool.ntp.org"
