+"""Control-v1 state/ownership tests. Only I/O and resource boundaries are fake."""
+import asyncio
+import json
+import sys
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'server'))
+from state_sync import DeviceSession, ScopedMqtt
+from mqtt_adapter import MqttAdapter
+from mqtt_pure import MqttPClient
+
+
+def snapshot(state='S3',rev=1,sub=''):
+    return dict(type='session_sync',protocol_version=2,control_protocol=1,device_time_ms=1000,
+        device_id='device-A',session_id='0'*32,interaction_id='',request_id='sync-1',
+        state=state,sub_state=sub,state_revision=rev,wake_required=state not in {'S1','S2','S4'},
+        companion_remaining_ms=0,reason='test')
+
+
+class Engine:
+    def __init__(self):
+        self._history=[];self._wake_ready_id=None;self._wake_ready_state=''
+        self._session_interaction_id=None
+    def on_client_connected(self,*args):pass
+    def apply_device_state(self,state):pass
+    def set_sink(self,*args):pass
+    def start(self):pass
+    def stop(self):pass
+    def close_session(self):pass
+
+
+class ControlTest(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.sent=[];self.clock=100.;self.background=[];self.ack=True
+        async def send(text):
+            data=json.loads(text) if text.startswith('{') else text
+            self.sent.append(data)
+            if isinstance(data,dict) and data['type']=='interaction_sync' and self.ack:
+                self.s.controls.accept_round_ack(dict(data,type='interaction_sync_ack',
+                    accepted=True,code='applied',device_time_ms=1000))
+        async def close(**kw):pass
+        self.ws=SimpleNamespace(send=send,close=close)
+        self.adapter=SimpleNamespace(identity=SimpleNamespace(enabled=True),cfg={},engine=SimpleNamespace(mqtt=None))
+        self.adapter.spawn=lambda coro:self.background.append(asyncio.create_task(coro))
+        self.s=DeviceSession(self.adapter,self.ws,Engine,lambda:self.clock,device_id='device-A')
+        await self.s.handle(snapshot());self.engine=self.s.ensure_engine()
+
+    async def asyncTearDown(self):
+        self.s.close()
+        await asyncio.gather(*self.s.cleanup,*self.background,*list(self.s.controls.tasks),return_exceptions=True)
+
+    async def test_first_wake_then_speech_have_distinct_confirmed_ids(self):
+        self.assertTrue(await self.s.deliver(self.engine,json.dumps(dict(type='wake_detected',interaction_id='wake_1'))))
+        self.assertEqual(self.s.interaction_id,'wake_1')
+        self.assertEqual(self.sent[-1]['interaction_seq'],1)
+        self.s.apply(dict(snapshot('S4',2),type='device_state'))
+        self.assertTrue(await self.s.deliver(self.engine,'MIC_START'))
