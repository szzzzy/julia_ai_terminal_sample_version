+"""Firmware-owned round barriers and bounded, acknowledged MQTT control."""
+import asyncio
+import json
+import logging
+import uuid
+
+log = logging.getLogger('vs.control')
+
+
+class SessionControl:
+    def __init__(self, session):
+        self.session = session
+        self.sequence = 0
+        self.confirmed_id = ''
+        self.control_sequence = 0
+        self.delivery_lock = asyncio.Lock()
+        self.control_lock = asyncio.Lock()
+        self.transitioning = False
+        self.pending_round = None
+        self.tasks = set()
+        self.device_ms = None
+        self.clock_at = None
+        self.last_result = None
+
+    def note_clock(self, data):
+        stamp = data.get('device_time_ms')
+        if type(stamp) is int and 0 <= stamp <= 2**53-1:
+            if self.device_ms is None or stamp > self.device_ms:
+                self.device_ms, self.clock_at = stamp, self.session.clock()
+
+    def accept_round_ack(self, data):
+        pending = self.pending_round
+        if not pending or not self.session.accepts(data):
+            return False
+        request, future = pending
+        if type(data.get('interaction_seq')) is not int: return False
+        if any(data.get(k) != request[k] for k in ('request_id','interaction_id','interaction_seq')):
+            return False
+        if type(data.get('accepted')) is not bool or not isinstance(data.get('code'), str):
+            return False
+        stamp = data.get('device_time_ms')
+        if type(stamp) is not int or not 0 <= stamp <= 2**53-1:
+            return False
+        if not future.done(): future.set_result(data)
+        return True
+
+    async def begin(self, engine, purpose, interaction_id=None):
+        s = self.session
+        if not s.owns() or s.engine is not engine or self.sequence >= 0xffffffff:
+            return False
+        self.transitioning = True
+        previous=list(self.tasks)
+        for task in previous: task.cancel()
+        seq = self.sequence + 1
+        iid = interaction_id or 'turn_' + uuid.uuid4().hex
+        request = dict(type='interaction_sync', interaction_id=iid,
+                       interaction_seq=seq, request_id='round_'+uuid.uuid4().hex, purpose=purpose)
+        future = s.loop.create_future()
+        self.pending_round = (request, future)
+        try:
+            if previous: await asyncio.gather(*previous,return_exceptions=True)
+            for _ in range(3):
+                if not s.owns() or s.engine is not engine: return False
+                await s.send_json(request)
+                try:
+                    ack = await asyncio.wait_for(asyncio.shield(future), 2)
+                except asyncio.TimeoutError:
+                    continue
+                if not ack['accepted']: return False
+                if not s.owns() or s.engine is not engine: return False
+                self.sequence = seq
+                self.confirmed_id = iid
+                self.control_sequence = 0
+                self.last_result = None
+                s.interaction_id = iid
+                engine._session_interaction_id = iid
+                self.note_clock(ack)
+                return True
+            # The device may have applied the barrier even when every ACK was lost.
+            # Do not invent a new sequence on this socket or resume the old round.
+            s.adapter.spawn(s.ws.close(code=4410, reason='interaction_sync_timeout'))
+            s.close()
+            return False
+        finally:
+            self.pending_round = None
+            if not future.done(): future.cancel()
+            self.transitioning = False
+
+    def queue(self, engine, text, sequence, interaction_id):
+        s = self.session
+        try:
+            data = json.loads(text)
+        except ValueError:
+            data = dict(type='command', command=text)
+        if not isinstance(data, dict): return
+        if (not s.owns() or s.engine is not engine or self.transitioning or
+                sequence != self.sequence or (interaction_id or '') != (s.interaction_id or '')): return
+        if len(self.tasks) >= 8:
+            log.warning('control queue full device=%s', s.device_id)
+            s.cancel_round(engine, 'control_queue_full')
+            return
+        task = s.loop.create_task(self._execute(engine, data, sequence, interaction_id))
+        self.tasks.add(task)
+        def done(t):
+            self.tasks.discard(t)
+            if not t.cancelled() and t.exception():
+                log.warning('control failed device=%s error=%s',s.device_id,type(t.exception()).__name__)
+        task.add_done_callback(done)
+
+    async def _execute(self, engine, data, sequence, iid):
+        s = self.session
+        async with self.control_lock:
+            def owns():
+                return (s.owns() and s.engine is engine and not self.transitioning and
+                        self.sequence == sequence and (s.interaction_id or '') == (iid or ''))
+            if not owns() or self.device_ms is None: return
+            mqtt = getattr(s.adapter.engine, 'mqtt', None)
+            if mqtt is None: return
+            if self.control_sequence >= 0xffffffff:
+                s.cancel_round(engine,'control_sequence_exhausted');return
+            self.control_sequence += 1
+            deadline = self.device_ms + int(max(0,s.clock()-self.clock_at)*1000) + 10000
+            payload = s.envelope(dict(data, interaction_id=iid or '', interaction_seq=sequence,
+                control_seq=self.control_sequence, request_id=uuid.uuid4().hex, expires_at_ms=deadline))
+            result = await mqtt.send_control(s.device_id,payload,owns)
+            self.last_result = result
+            if result is None and owns():
+                s.cancel_round(engine,'control_ack_timeout')
+                s.adapter.spawn(s.ws.close(code=4411,reason='control_ack_timeout'))
+            elif result is not None and not result.get('accepted') and owns() and result.get('code') in {
+                    'expired','invalid_deadline','out_of_order','request_id_conflict',
+                    'stale_request','invalid_envelope','round_sync_required'}:
+                s.cancel_round(engine,'control_rejected')
+                s.adapter.spawn(s.ws.close(code=4411,reason='control_rejected'))
+
+    def close(self):
+        for task in list(self.tasks): task.cancel()
+        if self.pending_round and not self.pending_round[1].done():
+            self.pending_round[1].cancel()
