# 键盘声探测的**实验配置**：只用于带标注回放的端点探测验证，
# 既不是产品默认值，也不是已验证的分类器。
# 判据口径：高带占比 R > 0.1、质心 > 600 Hz、连续 300 ms 内 ≥5 个有效帧、
# 噪声占比 ≥60%、确认 1 帧（帧长 20 ms）。
# 回放现象：首个键盘声在 2.38 s 结束，但整段被切成 4 个分段，且语音时序随之变化。
CONFIG_JULIA_LOCAL_CAPTURE_ENABLE=y
CONFIG_JULIA_CAPTURE_VAD_ENABLE=y
CONFIG_JULIA_CAPTURE_FFT_GATE=y
CONFIG_JULIA_CAPTURE_NOISE_WINDOW=y
CONFIG_JULIA_CAPTURE_NOISE_RATIO_PERMILLE=100
CONFIG_JULIA_CAPTURE_NOISE_CENTROID_HZ=600
CONFIG_JULIA_CAPTURE_NOISE_WINDOW_FRAMES=15
CONFIG_JULIA_CAPTURE_NOISE_MIN_ENERGY_FRAMES=5
CONFIG_JULIA_CAPTURE_NOISE_PERCENT=60
CONFIG_JULIA_CAPTURE_NOISE_CONFIRM_FRAMES=1
CONFIG_JULIA_VOICE_TIMING=y
